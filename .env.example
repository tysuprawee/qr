# Phone access requires a trusted HTTPS URL reachable from the phone.
PUBLIC_ORIGIN=https://roomshift.example.com
PORT=3000
HOST=127.0.0.1
# Set to 1 only behind your trusted TLS reverse proxy.
TRUST_PROXY=0
# Optional direct TLS (both files required).
# TLS_CERT=certs/cert.pem
# TLS_KEY=certs/key.pem
# Optional private SAM worker. Never exposed to the browser or QR code.
# SAM_WORKER_URL=http://127.0.0.1:8000/reconstruct
# SAM_WORKER_TOKEN=replace-with-a-long-random-server-secret
